# 코페이 테스트/운영 가맹점 (functions/.env 로 복사 — 커밋 금지)
KORPAY_MERCHANT_ID=test20011m
KORPAY_MKEY=
KORPAY_API_BASE=https://payments.korpay.com/v1

# 결제창 SDK base (가이드: payments.korpay.com/v1)
KORPAY_SDK_BASE=https://payments.korpay.com/v1

# 승인 후 프론트 리다이렉트 (HashRouter: .../#/payment/success)
APP_PUBLIC_URL=https://ez-hub.kr/ezpw

# 배포된 Functions 공개 URL (returnUrl 조합용)
# 예: https://asia-northeast3-gen-lang-client-0746903005.cloudfunctions.net
FUNCTIONS_PUBLIC_URL=

# Gen2 Cloud Run URL (권장 — firebase deploy 출력의 korpayConfirm URL)
# 예: https://korpayconfirm-xxxxx-du.a.run.app
KORPAY_CONFIRM_URL=

# Firestore 네임드 DB
FIRESTORE_DATABASE_ID=ai-studio-9c19ea8d-a769-47dc-b3b1-5cc0b25fe755
